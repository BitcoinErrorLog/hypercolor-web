# Optional Phase 1 evidence ingest. Leave empty to keep events in the
# in-memory ring buffer (max 256). window.__vibewareSink is attached only
# when NEXT_PUBLIC_E2E_HARNESS=1.
#
# NEXT_PUBLIC_* values are compile-time-inlined into the static export.
# The ingest token is a public write-only credential, not a secret.
# The store MUST re-validate with the P0 schema
# (scripts/vibeware-evidence.mjs). Do not put a real token here.
NEXT_PUBLIC_VIBEWARE_INGEST_URL=
NEXT_PUBLIC_VIBEWARE_INGEST_TOKEN=
NEXT_PUBLIC_E2E_HARNESS=
