{
  "name": "hypercolor-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/copy-sqlite-wasm.mjs",
    "postinstall": "node scripts/copy-sqlite-wasm.mjs",
    "build": "next build --webpack",
    "preview": "npx --yes serve out -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "proof:staging": "NEXT_PUBLIC_E2E_HARNESS=1 RUN_STAGING_DM=1 PLAYWRIGHT_STAGING_PORT=3000 playwright test e2e/dm-staging.spec.ts",
    "proof:staging:attach": "NEXT_PUBLIC_E2E_HARNESS=1 RUN_STAGING_ATTACH=1 PLAYWRIGHT_STAGING_PORT=3001 playwright test e2e/attachment-staging.spec.ts",
    "proof:staging:backup": "NEXT_PUBLIC_E2E_HARNESS=1 RUN_STAGING_BACKUP=1 PLAYWRIGHT_STAGING_PORT=3002 playwright test e2e/backup-staging.spec.ts",
    "proof:staging:groups": "NEXT_PUBLIC_E2E_HARNESS=1 RUN_STAGING_GROUPS=1 PLAYWRIGHT_STAGING_PORT=3003 playwright test e2e/groups-staging.spec.ts",
    "proof:staging:payments": "NEXT_PUBLIC_E2E_HARNESS=1 RUN_STAGING_PAYMENTS=1 PLAYWRIGHT_STAGING_PORT=3004 playwright test e2e/payments-staging.spec.ts",
    "proof:staging:ring": "node e2e/support/proof-staging-ring.mjs",
    "check:wasm": "node scripts/paykit-wasm-smoke.mjs",
    "check:wire": "bash scripts/check-wire-drift.sh",
    "check:vibeware": "node scripts/check-vibeware-selftest.mjs",
    "check:vibeware:pr": "node scripts/check-vibeware-pr.mjs",
    "check:vibeware:imports": "node scripts/check-vibeware-writable-imports.mjs",
    "backup:vector": "node scripts/backup-cross-restore-vector.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@scure/base": "^2.4.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^11.1.18",
    "light-bolt11-decoder": "^3.2.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "paykit-wasm": "file:vendor/paykit-wasm",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@synonymdev/pubky": "0.11.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
