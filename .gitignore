# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# AppleDouble files created on some external volumes
._*

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local checkout of the Hypercolor mobile pin (wire-drift CI)
.cache/

# typescript
*.tsbuildinfo
next-env.d.ts

# copied from @sqlite.org/sqlite-wasm on postinstall / prebuild
/public/sqlite3.wasm
