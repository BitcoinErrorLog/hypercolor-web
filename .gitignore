# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# AppleDouble files created on some external volumes
._*

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/.next-playwright
/tmp/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local checkout of the Hypercolor mobile pin (wire-drift CI)
.cache/

# typescript
*.tsbuildinfo
next-env.d.ts

# copied from @sqlite.org/sqlite-wasm on postinstall / prebuild
/public/sqlite3.wasm

# Ring simulator installs @synonymdev/pubky here (e2e/support/ensure-ring-deps.mjs).
# Keep only the install spec; never commit the dependency tree.
/e2e/support/.vendor/**
!/e2e/support/.vendor/package.json
